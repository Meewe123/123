{
  "name": "orbital-rush",
  "version": "1.1.0",
  "private": true,
  "description": "Orbital Rush \u2014 a one-thumb neon arcade game about the choice between a safe line and a greedy one. Zero dependencies at runtime.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "icons": "python3 tools/make_icons.py",
    "screenshots": "node tools/screenshots.mjs",
    "previews": "python3 tools/make_previews.py",
    "verify": "npm run icons && npm test && npm run test:e2e && npm run test:bundle",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync ios",
    "cap:open": "npx cap open ios",
    "build:single": "node scripts/build-single.mjs",
    "test:bundle": "node tests/bundle.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "playwright": "^1.63.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  }
}
